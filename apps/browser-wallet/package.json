{
  "name": "chipcoin-browser-wallet",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build:mldsa:browser-test": "vite build --config scripts/mldsa44-browser-test.vite.mjs",
    "test:mldsa:bundle": "node scripts/inspect-mldsa44-bundle.mjs",
    "test:mldsa:browser:firefox": "node scripts/run-mldsa44-browser-test.mjs --browser firefox",
    "test:mldsa:browser:chromium": "node scripts/run-mldsa44-browser-test.mjs --browser chromium",
    "prepare:firefox": "npm run build:firefox && rm -rf dist-firefox && mv dist dist-firefox",
    "lint:firefox": "npm run prepare:firefox && web-ext lint --source-dir dist-firefox",
    "package:firefox": "./package-firefox.sh",
    "package:firefox:sources": "./package-amo-source.sh",
    "release:firefox": "npm test && npm run prepare:firefox && npm run package:firefox",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "0.6.1",
    "preact": "^10.29.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "web-ext": "^10.3.0"
  }
}
