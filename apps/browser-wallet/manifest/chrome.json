{
  "manifest_version": 3,
  "name": "Chipcoin Wallet",
  "short_name": "Chipcoin",
  "version": "0.1.1",
  "description": "Chipcoin devnet and testnet browser wallet",
  "homepage_url": "https://chipcoinprotocol.com/wallet",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chipcoin Wallet"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content_script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/page_provider.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
